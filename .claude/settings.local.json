{
  "permissions": {
    "allow": [
      "mcp__playwright",
      "Bash(npm run:*)",
      "Bash(claude mcp:*)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_take_screenshot",
      "Bash(pip install:*)",
      "Bash(py --version)",
      "Bash(py:*)",
      "Bash(git push:*)",
      "PowerShell(Get-NetTCPConnection -LocalPort 6274,6277 -ErrorAction SilentlyContinue)",
      "PowerShell(Get-Process -Name node,python,uv -ErrorAction SilentlyContinue)"
    ],
    "deny": []
  },
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp@latest"
      ],
      "env": {}
    }
  }
}
